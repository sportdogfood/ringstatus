{
  "description": "RingStatus Codex controls: preserve task scope, block unauthorized writes, and require verification before finalization.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.mjs\"",
            "commandWindows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root=(git rev-parse --show-toplevel).Trim(); node (Join-Path -Path $root -ChildPath '.codex/hooks/session_start.mjs')\"",
            "timeout": 30,
            "statusMessage": "Starting RingStatus controls"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/user_prompt_submit.mjs\"",
            "commandWindows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root=(git rev-parse --show-toplevel).Trim(); node (Join-Path -Path $root -ChildPath '.codex/hooks/user_prompt_submit.mjs')\"",
            "timeout": 30,
            "statusMessage": "Loading RingStatus task controls"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use.mjs\"",
            "commandWindows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root=(git rev-parse --show-toplevel).Trim(); node (Join-Path -Path $root -ChildPath '.codex/hooks/pre_tool_use.mjs')\"",
            "timeout": 30,
            "statusMessage": "Checking RingStatus scope before tool use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_guard.mjs\"",
            "commandWindows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root=(git rev-parse --show-toplevel).Trim(); node (Join-Path -Path $root -ChildPath '.codex/hooks/stop_guard.mjs')\"",
            "timeout": 30,
            "statusMessage": "Checking RingStatus completion evidence"
          }
        ]
      }
    ]
  }
}

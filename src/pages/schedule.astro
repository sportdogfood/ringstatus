---
import "../../docs/tapactive-kit.css";
import "../styles/schedule-app.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>RingStatus Schedule</title>
    <meta name="description" content="RingStatus daily schedule prototype." />
  </head>
  <body>
    <div class="page" data-rs-schedule-page>
      <section class="app schedule-app" id="rs-schedule-app" aria-label="RingStatus schedule app">
        <header class="app-header">
          <button class="header-back is-invisible" id="rs-header-back" type="button">Back</button>
          <h1 class="header-title" id="rs-header-title">RingStatus</h1>
          <button class="header-action is-invisible" id="rs-header-action" type="button">Now</button>
        </header>

        <main class="app-main" id="rs-app-main">
          <div class="list-column">
            <div class="schedule-loading-card">Loading schedule data...</div>
          </div>
        </main>

        <nav class="app-nav" id="rs-app-nav" aria-label="Schedule navigation"></nav>
        <div id="rs-flyup-root"></div>
      </section>
    </div>

    <script>
      import "../schedule-app/app.js";
    </script>
  </body>
</html>

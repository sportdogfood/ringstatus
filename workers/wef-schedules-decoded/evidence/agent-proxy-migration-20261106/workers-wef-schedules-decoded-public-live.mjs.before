const root = '/iphonev2/index.php/esp/liveclassv2/';
const sgl = 'https://sgl.wellingtoninternational.com';
const routes = new Map([
  ['/homepage/getLiveClassStatus', ['https://sglapi.wellingtoninternational.com', { customer_id: /^15$/, datetimestamp: /^\d+$/ }]],
  [root + 'ListAjax', [sgl, { from_wp_api: /^true$/ }]],
  ['/iphone.php/esp/webservice/LiveScoreWidget', [sgl, {}]],
  [root + 'getLiveClassData', [sgl, { show_id: /^[1-9]\d*$/, cid: /^[1-9]\d*$/, t: /^\d+$/ }]]
]);
export function publicRoute(url) {
  const route = routes.get(url.pathname);
  if (!route) return null;
  const [origin, params] = route;
  const valid = [...url.searchParams.keys()].length === Object.keys(params).length &&
    Object.entries(params).every(([key, pattern]) => pattern.test(url.searchParams.get(key) || ''));
  return {origin, valid};
}
export function fetchPublic(url, origin) {
  const target = new URL(url.pathname + url.search, origin);
  return fetch(target, {redirect:'manual', signal:AbortSignal.timeout(25000), headers:{
    Accept:'application/json, text/plain, */*',
    'User-Agent':'Mozilla/5.0 (iPhone; CPU iPhone OS 18_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.5 Mobile/15E148 Safari/604.1',
    'Cache-Control':'no-cache', Pragma:'no-cache', Expires:'0', Origin:'https://www.wellingtoninternational.com',
    Referer:'https://www.wellingtoninternational.com/', 'sgl-request-origin':'SGL-API',
    authority:target.host, method:'GET', path:target.pathname+target.search, scheme:'https',
    'accept-encoding':'gzip, deflate, br, zstd', 'accept-language':'en-US,en;q=0.9', priority:'u=1, i',
    'sec-ch-ua':'"Not-A.Brand";v="99", "Microsoft Edge";v="157", "Chromium";v="157"',
    'sec-ch-ua-mobile':'?1', 'sec-ch-ua-platform':'"iOS"', 'sec-fetch-dest':'empty',
    'sec-fetch-mode':'cors', 'sec-fetch-site':'same-site'
  }});
}
